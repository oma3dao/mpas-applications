{
  "version": "1",
  "type": "MpasAdapterDeploymentConfig",
  "name": "github",
  "target": {
    "applicationDid": "did:web:wivity.com:applications:github-mcp-server"
  },
  "plugin": {
    "pluginDid": "did:web:wivity.com:plugins:github-mcp-server",
    "pluginVersion": "0.1.0",
    "artifactDid": "did:artifact:bafkreigiiv43a6faexmp3m7fkej3ppjpt2ik4dhstk7dsbvg2imif6wrkm",
    "path": "/absolute/path/to/mpas-applications/applications/github/plugin.json"
  },
  "credentialBindings": [
    {
      "credentialHandle": "githubPersonalAccessToken",
      "provider": "file"
    }
  ],
  "executionTarget": {
    "type": "mcp.stdio",
    "command": "docker",
    "args": [
      "run",
      "-i",
      "--rm",
      "-e",
      "GITHUB_PERSONAL_ACCESS_TOKEN",
      "ghcr.io/github/github-mcp-server@sha256:2b0c48b070f61e9d3969269ead600f62d00fb237b60ac849ef3d166ee7de9ad3"
    ],
    "env": {
      "GITHUB_PERSONAL_ACCESS_TOKEN": "{{credential:githubPersonalAccessToken}}"
    }
  },
  "policy": {
    "version": "1",
    "type": "MpasApplicationPolicy",
    "policyProfileUrl": "https://github.com/oma3dao/mpas/blob/main/specs/mpas-profile-policy-json.md",
    "applicationDid": "did:web:wivity.com:applications:github-mcp-server",
    "executionProfile": {
      "id": "did:web:profiles.oma3.org:mcp",
      "format": "mcp.toolsCall"
    },
    "defaultRequirement": {
      "type": "threshold",
      "threshold": 1,
      "eligibleSignerGroup": "approvers",
      "decision": "approve"
    },
    "signerGroups": {
      "all": [
        "REPLACE_WITH_PROPOSER_DID",
        "REPLACE_WITH_APPROVER_DID"
      ],
      "proposers": [
        "REPLACE_WITH_PROPOSER_DID"
      ],
      "approvers": [
        "REPLACE_WITH_APPROVER_DID"
      ]
    },
    "policies": {
      "add_issue_comment": [
        {
          "description": "Low-impact issue comments: proposer only.",
          "requirements": {
            "type": "proposerOnly"
          }
        }
      ],
      "add_reply_to_pull_request_comment": [
        {
          "description": "Low-impact PR comment replies: proposer only.",
          "requirements": {
            "type": "proposerOnly"
          }
        }
      ],
      "create_or_update_file": [
        {
          "description": "Branch file writes are recoverable; main is protected by GitHub rulesets. Proposer only.",
          "requirements": {
            "type": "proposerOnly"
          }
        }
      ],
      "delete_file": [
        {
          "description": "Branch file deletes are recoverable; main is protected by GitHub rulesets. Proposer only.",
          "requirements": {
            "type": "proposerOnly"
          }
        }
      ],
      "create_pull_request": [
        {
          "description": "Opening a PR does not land on main. Proposer only.",
          "requirements": {
            "type": "proposerOnly"
          }
        }
      ],
      "issue_write": [
        {
          "description": "Issue create/update on public repos. Proposer only.",
          "requirements": {
            "type": "proposerOnly"
          }
        }
      ],
      "push_files": [
        {
          "reject": true,
          "description": "Blocked: direct pushes to main are not permitted. Open a pull request instead.",
          "match": {
            "conditions": [
              {
                "source": "executionPayload",
                "path": "/arguments/branch",
                "op": "eq",
                "value": "main"
              }
            ]
          }
        },
        {
          "description": "Pushes to other branches are recoverable. Proposer only.",
          "match": {
            "conditions": [
              {
                "source": "executionPayload",
                "path": "/arguments/branch",
                "op": "neq",
                "value": "main"
              }
            ]
          },
          "requirements": {
            "type": "proposerOnly"
          }
        }
      ],
      "update_pull_request": [
        {
          "description": "PR metadata updates. Proposer only.",
          "requirements": {
            "type": "proposerOnly"
          }
        }
      ],
      "update_pull_request_branch": [
        {
          "description": "Updating a PR branch from base. Proposer only.",
          "requirements": {
            "type": "proposerOnly"
          }
        }
      ],
      "assign_copilot_to_issue": [
        {
          "reject": true,
          "description": "Blocked: assigning Copilot to issues is not permitted in this deployment."
        }
      ]
    }
  },
  "signerKeys": [
    {
      "did": "REPLACE_WITH_PROPOSER_DID",
      "label": "Proposer Signer"
    },
    {
      "did": "REPLACE_WITH_APPROVER_DID",
      "label": "Approver Signer"
    }
  ]
}
