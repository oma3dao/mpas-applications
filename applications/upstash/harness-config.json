{
  "version": "1",
  "type": "HarnessConfig",
  "upstream": {
    "command": "npx",
    "args": [
      "-y",
      "@upstash/mcp-server@0.2.4",
      "--email",
      "{{credential:upstashEmail}}",
      "--api-key",
      "{{credential:upstashApiKey}}"
    ],
    "env": {
      "UPSTASH_EMAIL": "{{credential:upstashEmail}}",
      "UPSTASH_API_KEY": "{{credential:upstashApiKey}}"
    },
    "distribution": {
      "type": "npm",
      "package": "@upstash/mcp-server",
      "version": "0.2.4",
      "registry": "https://registry.npmjs.org/",
      "versionMatchesServerInfo": false,
      "reconciliation": "metadata.serverInfo.version is 0.1.0, the server's internal version. CHANGELOG.md states 'Captured and governed all 33 tools from @upstash/mcp-server 0.2.4'. As with postgres, 0.1.0 also exists on npm, so pinning to serverInfo.version would have resolved to the wrong package."
    }
  },
  "intentionalDeviations": {
    "renamedTools": {},
    "wrappedSchemas": [],
    "modifiedDescriptions": [],
    "addedTools": [],
    "outputSchemaUnions": [],
    "extensionCapabilities": [
      "io.modelcontextprotocol/tasks",
      "org.oma3/mpas"
    ],
    "protocolModes": {
      "tasks": {
        "handshake": "server/discover",
        "addedTools": [],
        "modifiedDescriptions": [],
        "outputSchemaUnions": [],
        "extensionCapabilities": [
          "io.modelcontextprotocol/tasks",
          "org.oma3/mpas"
        ]
      },
      "compatibility": {
        "handshake": "initialize",
        "addedTools": [
          "mpas_wait_for_action_result"
        ],
        "modifiedDescriptions": [
          "application-tools"
        ],
        "outputSchemaUnions": [
          "application-tools-with-output-schema"
        ],
        "extensionCapabilities": []
      }
    },
    "note": "The bridge auto-detects MCP Tasks or the conventional MPAS wait-tool compatibility surface. Tasks mode preserves upstream tool definitions."
  }
}
