{
  "version": "1",
  "type": "MpasApplicationPlugin",
  "pluginDid": "did:web:wivity.com:plugins:upstash-mcp-server",
  "pluginVersion": "0.1.0",
  "publisherDid": "did:web:wivity.com",
  "applicationDid": "did:web:wivity.com:applications:upstash-mcp-server",
  "executionProfile": {
    "id": "did:web:profiles.oma3.org:mcp",
    "format": "mcp.toolsCall",
    "protocolVersion": "2024-11-05"
  },
  "credentialRequirements": [
    {
      "type": "upstashApiCredential",
      "requiredCapabilities": [
        "redis:read",
        "redis:write",
        "qstash:read",
        "qstash:write",
        "workflow:read",
        "workflow:write",
        "box:write"
      ],
      "description": "Upstash account email and API key supplied only within the credential adapter and scoped to the intended account. API keys, database passwords, REST tokens, and QStash tokens must never be returned to the proposer."
    }
  ],
  "operations": {
    "box_agent_run": {
      "description": "Run an AI agent prompt inside an Upstash Box. The agent has access to shell, filesystem, and git inside the box. It reasons, executes commands, and iterates until the task is complete. This is a synchronous call that may take a while depending on the complexity of the prompt.",
      "impact": "critical",
      "executionPayloadSchema": {
        "type": "object",
        "required": [
          "name",
          "arguments"
        ],
        "properties": {
          "name": {
            "const": "box_agent_run"
          },
          "arguments": {
            "type": "object",
            "properties": {
              "box_id": {
                "type": "string",
                "description": "The box ID to run the agent in"
              },
              "prompt": {
                "type": "string",
                "description": "The natural-language prompt for the agent to execute"
              },
              "model": {
                "type": "string",
                "description": "Override the box's default LLM model for this run"
              },
              "folder": {
                "type": "string",
                "description": "Working directory inside the box for the agent"
              },
              "box_api_key": {
                "type": "string",
                "description": "Box API key (starts with 'box_'). Check the project's .env file for BOX_API_KEY, or ask the user for it."
              }
            },
            "required": [
              "box_id",
              "prompt",
              "box_api_key"
            ],
            "additionalProperties": false,
            "$schema": "http://json-schema.org/draft-07/schema#"
          }
        },
        "additionalProperties": false
      }
    },
    "box_exec": {
      "description": "Execute a shell command inside an Upstash Box container. Use this for file operations, git commands, package installs, or any shell operation inside the box.",
      "impact": "critical",
      "executionPayloadSchema": {
        "type": "object",
        "required": [
          "name",
          "arguments"
        ],
        "properties": {
          "name": {
            "const": "box_exec"
          },
          "arguments": {
            "type": "object",
            "properties": {
              "box_id": {
                "type": "string",
                "description": "The box ID to execute the command in"
              },
              "command": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Command and arguments as an array (e.g. ['bash', '-c', 'ls -la'])"
              },
              "folder": {
                "type": "string",
                "description": "Working directory inside the box"
              },
              "async": {
                "type": "boolean",
                "description": "If true, return immediately without waiting for completion"
              },
              "box_api_key": {
                "type": "string",
                "description": "Box API key (starts with 'box_'). Check the project's .env file for BOX_API_KEY, or ask the user for it."
              }
            },
            "required": [
              "box_id",
              "command",
              "box_api_key"
            ],
            "additionalProperties": false,
            "$schema": "http://json-schema.org/draft-07/schema#"
          }
        },
        "additionalProperties": false
      }
    },
    "box_manage": {
      "description": "Manage Upstash Box containers. Supports creating, listing, getting, deleting, pausing, resuming, and forking boxes. Boxes are secure cloud containers with built-in AI agent capabilities.",
      "impact": "critical",
      "executionPayloadSchema": {
        "type": "object",
        "required": [
          "name",
          "arguments"
        ],
        "properties": {
          "name": {
            "const": "box_manage"
          },
          "arguments": {
            "type": "object",
            "properties": {
              "action": {
                "type": "string",
                "enum": [
                  "create",
                  "list",
                  "get",
                  "delete",
                  "pause",
                  "resume",
                  "fork"
                ],
                "description": "The action to perform"
              },
              "box_id": {
                "type": "string",
                "description": "Box ID (required for get, delete, pause, resume, fork)"
              },
              "name": {
                "type": "string",
                "description": "Display name for the box"
              },
              "model": {
                "type": "string",
                "description": "LLM model to use (e.g. 'claude/sonnet_4_6', 'openai/o4-mini'). Required for create"
              },
              "agent": {
                "type": "string",
                "enum": [
                  "claude-code",
                  "codex",
                  "opencode"
                ],
                "default": "claude-code",
                "description": "Agent type (default: claude-code)"
              },
              "runtime": {
                "type": "string",
                "default": "node",
                "description": "Runtime environment (e.g. 'node', 'python')"
              },
              "agent_api_key": {
                "type": "string",
                "description": "API key for the AI agent provider. Empty uses managed key"
              },
              "env_vars": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "description": "Environment variables to set in the box"
              },
              "clone_repo": {
                "type": "string",
                "description": "Git repository URL to clone into the box"
              },
              "clone_token": {
                "type": "string",
                "description": "Token for cloning private repositories"
              },
              "ephemeral": {
                "type": "boolean",
                "description": "If true, box auto-deletes after TTL expires"
              },
              "ttl": {
                "type": "number",
                "description": "Time-to-live in seconds for ephemeral boxes (max 259200 = 3 days)"
              },
              "status": {
                "type": "string",
                "enum": [
                  "active",
                  "deleted"
                ],
                "description": "Filter for list action: 'active' (default) or 'deleted'"
              },
              "box_api_key": {
                "type": "string",
                "description": "Box API key (starts with 'box_'). Check the project's .env file for BOX_API_KEY, or ask the user for it."
              }
            },
            "required": [
              "action",
              "box_api_key"
            ],
            "additionalProperties": false,
            "$schema": "http://json-schema.org/draft-07/schema#"
          }
        },
        "additionalProperties": false
      }
    },
    "box_preview": {
      "description": "Manage preview URLs for web applications running inside an Upstash Box. Create public URLs to access services running on specific ports, list existing previews, or delete them.",
      "impact": "high",
      "executionPayloadSchema": {
        "type": "object",
        "required": [
          "name",
          "arguments"
        ],
        "properties": {
          "name": {
            "const": "box_preview"
          },
          "arguments": {
            "type": "object",
            "properties": {
              "action": {
                "type": "string",
                "enum": [
                  "create",
                  "list",
                  "delete"
                ],
                "description": "The action to perform"
              },
              "box_id": {
                "type": "string",
                "description": "The box ID"
              },
              "port": {
                "type": "number",
                "minimum": 1,
                "maximum": 65535,
                "description": "Port number (required for create and delete)"
              },
              "basic_auth": {
                "type": "boolean",
                "description": "Enable basic auth on the preview URL (create only)"
              },
              "bearer_token": {
                "type": "boolean",
                "description": "Enable bearer token auth on the preview URL (create only)"
              },
              "box_api_key": {
                "type": "string",
                "description": "Box API key (starts with 'box_'). Check the project's .env file for BOX_API_KEY, or ask the user for it."
              }
            },
            "required": [
              "action",
              "box_id",
              "box_api_key"
            ],
            "additionalProperties": false,
            "$schema": "http://json-schema.org/draft-07/schema#"
          }
        },
        "additionalProperties": false
      }
    },
    "box_snapshots": {
      "description": "Manage Upstash Box snapshots. Create full filesystem snapshots of a box, list snapshots, delete them, or restore a box from a snapshot.",
      "impact": "critical",
      "executionPayloadSchema": {
        "type": "object",
        "required": [
          "name",
          "arguments"
        ],
        "properties": {
          "name": {
            "const": "box_snapshots"
          },
          "arguments": {
            "type": "object",
            "properties": {
              "action": {
                "type": "string",
                "enum": [
                  "create",
                  "list",
                  "list_all",
                  "delete",
                  "restore"
                ],
                "description": "The action to perform. 'list' lists snapshots for a specific box, 'list_all' lists all your snapshots"
              },
              "box_id": {
                "type": "string",
                "description": "Box ID (required for create, list, delete)"
              },
              "snapshot_id": {
                "type": "string",
                "description": "Snapshot ID (required for delete and restore)"
              },
              "name": {
                "type": "string",
                "description": "Name for the snapshot (auto-generated if empty)"
              },
              "model": {
                "type": "string",
                "description": "LLM model for the restored box (required for restore)"
              },
              "runtime": {
                "type": "string",
                "description": "Override the snapshot's runtime for the restored box"
              },
              "env_vars": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "description": "Environment variables for the restored box"
              },
              "ephemeral": {
                "type": "boolean",
                "description": "Create the restored box as ephemeral"
              },
              "ttl": {
                "type": "number",
                "description": "TTL in seconds for the restored ephemeral box (max 259200)"
              },
              "box_api_key": {
                "type": "string",
                "description": "Box API key (starts with 'box_'). Check the project's .env file for BOX_API_KEY, or ask the user for it."
              }
            },
            "required": [
              "action",
              "box_api_key"
            ],
            "additionalProperties": false,
            "$schema": "http://json-schema.org/draft-07/schema#"
          }
        },
        "additionalProperties": false
      }
    },
    "qstash_get_user_token": {
      "description": "Get the QSTASH_TOKEN and QSTASH_URL of the current user. This\n    is not needed for the mcp tools since the token is automatically fetched from\n    the Upstash API for them.",
      "impact": "critical",
      "executionPayloadSchema": {
        "type": "object",
        "required": [
          "name",
          "arguments"
        ],
        "properties": {
          "name": {
            "const": "qstash_get_user_token"
          },
          "arguments": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "properties": {}
          }
        },
        "additionalProperties": false
      }
    },
    "qstash_publish_message": {
      "description": "Publish a message to a destination URL using QStash. This\n    sends an HTTP request to the specified destination via QStash's message\n    queue. This can also be used to trigger a upstash workflow run.",
      "impact": "high",
      "executionPayloadSchema": {
        "type": "object",
        "required": [
          "name",
          "arguments"
        ],
        "properties": {
          "name": {
            "const": "qstash_publish_message"
          },
          "arguments": {
            "type": "object",
            "properties": {
              "destination": {
                "type": "string",
                "description": "The destination URL to send the message to (e.g., 'https://example.com')"
              },
              "body": {
                "type": "string",
                "description": "Request body (JSON string or plain text)"
              },
              "method": {
                "type": "string",
                "enum": [
                  "GET",
                  "POST",
                  "PUT",
                  "DELETE",
                  "PATCH"
                ],
                "description": "HTTP method (optional, defaults to POST)",
                "default": "POST"
              },
              "delay": {
                "type": "string",
                "description": "Delay before message delivery (e.g., '10s', '5m', '1h')"
              },
              "retries": {
                "type": "number",
                "description": "Number of retries on failure, default is 3"
              },
              "callback": {
                "type": "string",
                "description": "Callback URL that will be called when the message is successfully delivered"
              },
              "failureCallback": {
                "type": "string",
                "description": "Callback URL that will be called when the message is failed to deliver"
              },
              "timeout": {
                "type": "string",
                "description": "Request timeout (e.g., '30s', '1h')"
              },
              "queueName": {
                "type": "string",
                "description": "Queue name to use, you have to first create the queue in upstash. Prefer the flow control key instead"
              },
              "flow_control": {
                "type": "object",
                "properties": {
                  "key": {
                    "type": "string",
                    "description": "Unique identifier for grouping messages under same flow control rules"
                  },
                  "parallelism": {
                    "type": "number",
                    "description": "Max concurrent active calls (default: unlimited)"
                  },
                  "rate": {
                    "type": "number",
                    "description": "Max calls per period (default: unlimited)"
                  },
                  "period": {
                    "type": "string",
                    "description": "Time window for rate limit (e.g., '1s', '1m', '1h', default: '1s')"
                  }
                },
                "required": [
                  "key"
                ],
                "additionalProperties": false,
                "description": "Flow control for rate limiting and parallelism management"
              },
              "extraHeaders": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "description": "Extra headers to add to the request"
              },
              "region": {
                "type": "string",
                "enum": [
                  "eu",
                  "us",
                  "local"
                ],
                "default": "eu",
                "description": "QStash region to use. To use local mode, pick `local`"
              },
              "local_mode_port": {
                "type": "number",
                "default": 8080,
                "description": "Only provide when using local mode and if default does not work, the port is usually in the .env file"
              },
              "qstash_creds": {
                "type": "object",
                "properties": {
                  "url": {
                    "type": "string"
                  },
                  "token": {
                    "type": "string"
                  }
                },
                "required": [
                  "url",
                  "token"
                ],
                "additionalProperties": false,
                "description": "Custom qstash credentials, overrides `region`"
              }
            },
            "required": [
              "destination"
            ],
            "additionalProperties": false,
            "$schema": "http://json-schema.org/draft-07/schema#"
          }
        },
        "additionalProperties": false
      }
    },
    "qstash_schedules_manage": {
      "description": "Create, update, or manage QStash schedules. This tool handles create, update (by providing scheduleId), pause, resume, and delete operations in one unified interface.",
      "impact": "high",
      "executionPayloadSchema": {
        "type": "object",
        "required": [
          "name",
          "arguments"
        ],
        "properties": {
          "name": {
            "const": "qstash_schedules_manage"
          },
          "arguments": {
            "type": "object",
            "properties": {
              "operation": {
                "type": "string",
                "enum": [
                  "create",
                  "update",
                  "pause",
                  "resume",
                  "delete"
                ],
                "description": "The operation to perform"
              },
              "scheduleId": {
                "type": "string",
                "description": "Schedule ID (required for update, pause, resume, delete operations)"
              },
              "destination": {
                "type": "string",
                "description": "Destination URL or topic name (required for create/update)"
              },
              "cron": {
                "type": "string",
                "description": "Cron expression (required for create/update)"
              },
              "method": {
                "type": "string",
                "enum": [
                  "GET",
                  "POST",
                  "PUT",
                  "DELETE",
                  "PATCH"
                ],
                "description": "HTTP method (optional, defaults to POST)"
              },
              "headers": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "description": "Request headers as key-value pairs"
              },
              "body": {
                "type": "string",
                "description": "Request body"
              },
              "delay": {
                "type": "string",
                "description": "Delay before message delivery (e.g., '10s', '5m', '1h')"
              },
              "retries": {
                "type": "number",
                "description": "Number of retries on failure"
              },
              "callback": {
                "type": "string",
                "description": "Callback URL for successful delivery"
              },
              "failureCallback": {
                "type": "string",
                "description": "Callback URL for failed delivery"
              },
              "timeout": {
                "type": "string",
                "description": "Request timeout (e.g., '30s')"
              },
              "queueName": {
                "type": "string",
                "description": "Queue name to use"
              },
              "region": {
                "type": "string",
                "enum": [
                  "eu",
                  "us",
                  "local"
                ],
                "default": "eu",
                "description": "QStash region to use. To use local mode, pick `local`"
              },
              "local_mode_port": {
                "type": "number",
                "default": 8080,
                "description": "Only provide when using local mode and if default does not work, the port is usually in the .env file"
              },
              "qstash_creds": {
                "type": "object",
                "properties": {
                  "url": {
                    "type": "string"
                  },
                  "token": {
                    "type": "string"
                  }
                },
                "required": [
                  "url",
                  "token"
                ],
                "additionalProperties": false,
                "description": "Custom qstash credentials, overrides `region`"
              }
            },
            "required": [
              "operation"
            ],
            "additionalProperties": false,
            "$schema": "http://json-schema.org/draft-07/schema#"
          }
        },
        "additionalProperties": false
      }
    },
    "redis_database_create_new": {
      "description": "Create a new Upstash redis database. \nNOTE: Ask user for the region and name of the database.\nNOTE: Don't show the database ID from the response to the user unless explicitly asked or needed.\n",
      "impact": "high",
      "executionPayloadSchema": {
        "type": "object",
        "required": [
          "name",
          "arguments"
        ],
        "properties": {
          "name": {
            "const": "redis_database_create_new"
          },
          "arguments": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "Name of the database."
              },
              "primary_region": {
                "type": "string",
                "enum": [
                  "us-east-1",
                  "us-west-1",
                  "us-west-2",
                  "eu-west-1",
                  "eu-central-1",
                  "ap-southeast-1",
                  "ap-southeast-2",
                  "sa-east-1"
                ],
                "description": "Primary Region of the Global Database."
              },
              "read_regions": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "us-east-1",
                    "us-west-1",
                    "us-west-2",
                    "eu-west-1",
                    "eu-central-1",
                    "ap-southeast-1",
                    "ap-southeast-2",
                    "sa-east-1"
                  ]
                },
                "description": "Array of read regions of the db"
              }
            },
            "required": [
              "name",
              "primary_region"
            ],
            "additionalProperties": false,
            "$schema": "http://json-schema.org/draft-07/schema#"
          }
        },
        "additionalProperties": false
      }
    },
    "redis_database_delete": {
      "description": "Delete an Upstash redis database.",
      "impact": "critical",
      "executionPayloadSchema": {
        "type": "object",
        "required": [
          "name",
          "arguments"
        ],
        "properties": {
          "name": {
            "const": "redis_database_delete"
          },
          "arguments": {
            "type": "object",
            "properties": {
              "database_id": {
                "type": "string",
                "description": "The ID of the database to delete."
              }
            },
            "required": [
              "database_id"
            ],
            "additionalProperties": false,
            "$schema": "http://json-schema.org/draft-07/schema#"
          }
        },
        "additionalProperties": false
      }
    },
    "redis_database_manage_backup": {
      "description": "Create, delete, or restore backups for a specific Upstash redis database. This tool handles all backup operations in one unified interface.",
      "impact": "critical",
      "executionPayloadSchema": {
        "type": "object",
        "required": [
          "name",
          "arguments"
        ],
        "properties": {
          "name": {
            "const": "redis_database_manage_backup"
          },
          "arguments": {
            "type": "object",
            "properties": {
              "database_id": {
                "type": "string",
                "description": "The ID of the database to manage backups for."
              },
              "operation": {
                "type": "string",
                "enum": [
                  "create",
                  "delete",
                  "restore"
                ],
                "description": "The backup operation to perform: create, delete, or restore."
              },
              "backup_name": {
                "type": "string",
                "description": "Name for the backup (required for create operation)."
              },
              "backup_id": {
                "type": "string",
                "description": "ID of the backup (required for delete and restore operations)."
              }
            },
            "required": [
              "database_id",
              "operation"
            ],
            "additionalProperties": false,
            "$schema": "http://json-schema.org/draft-07/schema#"
          }
        },
        "additionalProperties": false
      }
    },
    "redis_database_reset_password": {
      "description": "Reset the password of an Upstash redis database.",
      "impact": "critical",
      "executionPayloadSchema": {
        "type": "object",
        "required": [
          "name",
          "arguments"
        ],
        "properties": {
          "name": {
            "const": "redis_database_reset_password"
          },
          "arguments": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "description": "The ID of your database."
              }
            },
            "required": [
              "id"
            ],
            "additionalProperties": false,
            "$schema": "http://json-schema.org/draft-07/schema#"
          }
        },
        "additionalProperties": false
      }
    },
    "redis_database_run_redis_commands": {
      "description": "Run one or more Redis commands on a specific Upstash redis database. Either provide database_id OR both database_rest_url and database_rest_token.\nNOTE: For discovery, use SCAN over KEYS. Use TYPE to get the type of a key.\nNOTE: SCAN cursor [MATCH pattern] [COUNT count] [TYPE type]\nNOTE: Multiple commands will be executed as a pipeline for better performance.",
      "impact": "critical",
      "executionPayloadSchema": {
        "type": "object",
        "required": [
          "name",
          "arguments"
        ],
        "properties": {
          "name": {
            "const": "redis_database_run_redis_commands"
          },
          "arguments": {
            "type": "object",
            "properties": {
              "database_id": {
                "type": "string",
                "description": "The ID of the database to run commands on."
              },
              "database_rest_url": {
                "type": "string",
                "description": "The REST URL of the database. Example: https://***.upstash.io"
              },
              "database_rest_token": {
                "type": "string",
                "description": "The REST token of the database."
              },
              "commands": {
                "type": "array",
                "items": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "description": "The Redis commands to run. For single command: [['SET', 'foo', 'bar']], for multiple: [['SET', 'foo', 'bar'], ['GET', 'foo']]"
              }
            },
            "required": [
              "commands"
            ],
            "additionalProperties": false,
