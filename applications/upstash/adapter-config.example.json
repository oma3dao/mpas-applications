{
  "version": "1",
  "type": "MpasAdapterDeploymentConfig",
  "name": "upstash",
  "target": {
    "applicationDid": "did:web:wivity.com:applications:upstash-mcp-server"
  },
  "plugin": {
    "pluginDid": "did:web:wivity.com:plugins:upstash-mcp-server",
    "pluginVersion": "0.1.0",
    "artifactDid": "did:artifact:bafkreidstznmolvneqrgwcrpoi45ixoglclqyf7qiudgaqeysq6rvy6xe4",
    "path": "/absolute/path/to/mpas-applications/applications/upstash/plugin.json"
  },
  "credentialBindings": [
    {
      "credentialHandle": "upstashEmail",
      "provider": "file"
    },
    {
      "credentialHandle": "upstashApiKey",
      "provider": "file"
    }
  ],
  "executionTarget": {
    "type": "mcp.stdio",
    "command": "npx",
    "args": [
      "-y",
      "@upstash/mcp-server@0.2.4",
      "--email",
      "{{credential:upstashEmail}}",
      "--api-key",
      "{{credential:upstashApiKey}}"
    ],
    "env": {
      "UPSTASH_EMAIL": "{{credential:upstashEmail}}",
      "UPSTASH_API_KEY": "{{credential:upstashApiKey}}"
    }
  },
  "policy": {
    "version": "1",
    "type": "MpasApplicationPolicy",
    "policyProfileUrl": "https://github.com/oma3dao/mpas/blob/main/specs/mpas-profile-policy-json.md",
    "applicationDid": "did:web:wivity.com:applications:upstash-mcp-server",
    "executionProfile": {
      "id": "did:web:profiles.oma3.org:mcp",
      "format": "mcp.toolsCall"
    },
    "defaultRequirement": {
      "type": "threshold",
      "threshold": 1,
      "eligibleSignerGroup": "approvers",
      "decision": "approve"
    },
    "signerGroups": {
      "all": [
        "REPLACE_WITH_PROPOSER_DID",
        "REPLACE_WITH_APPROVER_DID"
      ],
      "proposers": [
        "REPLACE_WITH_PROPOSER_DID"
      ],
      "approvers": [
        "REPLACE_WITH_APPROVER_DID"
      ]
    },
    "policies": {
      "qstash_get_user_token": [
        {
          "reject": true,
          "description": "Returning a reusable QStash token would let a proposer bypass MPAS and is disabled for proposer deployments.",
          "match": {}
        }
      ]
    }
  },
  "signerKeys": [
    {
      "did": "REPLACE_WITH_PROPOSER_DID",
      "label": "Proposer Signer"
    },
    {
      "did": "REPLACE_WITH_APPROVER_DID",
      "label": "Approver Signer"
    }
  ]
}
