{
  "version": "1",
  "type": "MpasApplicationPlugin",
  "pluginDid": "did:web:wivity.com:plugins:outlook-mcp-server",
  "pluginVersion": "0.1.0",
  "publisherDid": "did:web:wivity.com",
  "applicationDid": "did:web:wivity.com:applications:outlook-mcp-server",
  "executionProfile": {
    "id": "did:web:profiles.oma3.org:mcp",
    "format": "mcp.toolsCall",
    "protocolVersion": "2024-11-05"
  },
  "credentialRequirements": [
    {
      "type": "microsoftGraphDelegatedCredential",
      "requiredCapabilities": [
        "Mail.ReadWrite",
        "Mail.Send",
        "Calendars.ReadWrite",
        "Contacts.ReadWrite",
        "Tasks.ReadWrite",
        "User.Read",
        "offline_access"
      ],
      "description": "Delegated Microsoft Graph credential for the intended personal Outlook account, retained and exercised only by the credential adapter. OAuth access and refresh tokens must never be disclosed to the proposer."
    }
  ],
  "operations": {
    "outlook_create_event": {
      "description": "Create a calendar event with optional attendees, recurrence, and Teams online meeting.\n\nExample: outlook_create_event(subject=\"Q3 review\", start=\"2026-08-15T14:00:00Z\",\nend=\"2026-08-15T15:00:00Z\", attendees=[\"alice@acme.com\"], is_online=True)\n`start`/`end` are ISO 8601. `recurrence` accepts a simple string (\"daily\", \"weekly\", \"monthly\").\n",
      "impact": "high",
      "executionPayloadSchema": {
        "type": "object",
        "required": [
          "name",
          "arguments"
        ],
        "properties": {
          "name": {
            "const": "outlook_create_event"
          },
          "arguments": {
            "properties": {
              "subject": {
                "title": "Subject",
                "type": "string"
              },
              "start": {
                "title": "Start",
                "type": "string"
              },
              "end": {
                "title": "End",
                "type": "string"
              },
              "location": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Location"
              },
              "body": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Body"
              },
              "attendees": {
                "anyOf": [
                  {
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Attendees"
              },
              "is_all_day": {
                "default": false,
                "title": "Is All Day",
                "type": "boolean"
              },
              "is_online": {
                "default": false,
                "title": "Is Online",
                "type": "boolean"
              },
              "recurrence": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Recurrence"
              }
            },
            "required": [
              "subject",
              "start",
              "end"
            ],
            "title": "outlook_create_eventArguments",
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    },
    "outlook_delete_event": {
      "description": "Delete a calendar event by ID (cancels and notifies attendees if you're the organizer).",
      "impact": "high",
      "executionPayloadSchema": {
        "type": "object",
        "required": [
          "name",
          "arguments"
        ],
        "properties": {
          "name": {
            "const": "outlook_delete_event"
          },
          "arguments": {
            "properties": {
              "event_id": {
                "title": "Event Id",
                "type": "string"
              }
            },
            "required": [
              "event_id"
            ],
            "title": "outlook_delete_eventArguments",
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    },
    "outlook_delete_folder": {
      "description": "Delete a user-created mail folder by ID; refuses well-known folders (inbox, sentitems).",
      "impact": "critical",
      "executionPayloadSchema": {
        "type": "object",
        "required": [
          "name",
          "arguments"
        ],
        "properties": {
          "name": {
            "const": "outlook_delete_folder"
          },
          "arguments": {
            "properties": {
              "folder_id": {
                "title": "Folder Id",
                "type": "string"
              }
            },
            "required": [
              "folder_id"
            ],
            "title": "outlook_delete_folderArguments",
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    },
    "outlook_delete_inbox_override": {
      "description": "Delete a Focused Inbox per-sender override rule by its ID.",
      "impact": "low",
      "executionPayloadSchema": {
        "type": "object",
        "required": [
          "name",
          "arguments"
        ],
        "properties": {
          "name": {
            "const": "outlook_delete_inbox_override"
          },
          "arguments": {
            "properties": {
              "override_id": {
                "title": "Override Id",
                "type": "string"
              }
            },
            "required": [
              "override_id"
            ],
            "title": "outlook_delete_inbox_overrideArguments",
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    },
    "outlook_delete_message": {
      "description": "Delete a message — soft delete (to Deleted Items) by default; permanent=True to hard-delete.\n\nThis is the canonical way to delete a message. Do NOT use\noutlook_move_message(folder=\"deleteditems\") for deletion.\n",
      "impact": "critical",
      "executionPayloadSchema": {
        "type": "object",
        "required": [
          "name",
          "arguments"
        ],
        "properties": {
          "name": {
            "const": "outlook_delete_message"
          },
          "arguments": {
            "properties": {
              "message_id": {
                "title": "Message Id",
                "type": "string"
              },
              "permanent": {
                "default": false,
                "title": "Permanent",
                "type": "boolean"
              }
            },
            "required": [
              "message_id"
            ],
            "title": "outlook_delete_messageArguments",
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    },
    "outlook_download_attachment": {
      "description": "Download an attachment from a message and write decoded bytes to `save_path` on the host.",
      "impact": "high",
      "executionPayloadSchema": {
        "type": "object",
        "required": [
          "name",
          "arguments"
        ],
        "properties": {
          "name": {
            "const": "outlook_download_attachment"
          },
          "arguments": {
            "properties": {
              "message_id": {
                "title": "Message Id",
                "type": "string"
              },
              "attachment_id": {
                "title": "Attachment Id",
                "type": "string"
              },
              "save_path": {
                "title": "Save Path",
                "type": "string"
              }
            },
            "required": [
              "message_id",
              "attachment_id",
              "save_path"
            ],
            "title": "outlook_download_attachmentArguments",
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    },
    "outlook_forward": {
      "description": "Forward an existing message to new recipients, with optional comment.",
      "impact": "high",
      "executionPayloadSchema": {
        "type": "object",
        "required": [
          "name",
          "arguments"
        ],
        "properties": {
          "name": {
            "const": "outlook_forward"
          },
          "arguments": {
            "properties": {
              "message_id": {
                "title": "Message Id",
                "type": "string"
              },
              "to": {
                "items": {
                  "type": "string"
                },
                "title": "To",
                "type": "array"
              },
              "comment": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Comment"
              }
            },
            "required": [
              "message_id",
              "to"
            ],
            "title": "outlook_forwardArguments",
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    },
    "outlook_reply": {
      "description": "Reply (or reply-all) to an email message.\n\nUse this for email; use outlook_rsvp for calendar meeting invites.\n",
      "impact": "high",
      "executionPayloadSchema": {
        "type": "object",
        "required": [
          "name",
          "arguments"
        ],
        "properties": {
          "name": {
            "const": "outlook_reply"
          },
          "arguments": {
            "properties": {
              "message_id": {
                "title": "Message Id",
                "type": "string"
              },
              "body": {
                "title": "Body",
                "type": "string"
              },
              "reply_all": {
                "default": false,
                "title": "Reply All",
                "type": "boolean"
              },
              "is_html": {
                "default": false,
                "title": "Is Html",
                "type": "boolean"
              }
            },
            "required": [
              "message_id",
              "body"
            ],
            "title": "outlook_replyArguments",
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    },
    "outlook_rsvp": {
      "description": "RSVP to a calendar meeting invite. `response` is \"accept\", \"decline\", or \"tentative\".\n\nUse this for meeting invites; use outlook_reply to reply to a regular email message.\n",
      "impact": "low",
      "executionPayloadSchema": {
        "type": "object",
        "required": [
          "name",
          "arguments"
        ],
        "properties": {
          "name": {
            "const": "outlook_rsvp"
          },
          "arguments": {
            "properties": {
              "event_id": {
                "title": "Event Id",
                "type": "string"
              },
              "response": {
                "title": "Response",
                "type": "string"
              },
              "message": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Message"
              }
            },
            "required": [
              "event_id",
              "response"
            ],
            "title": "outlook_rsvpArguments",
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    },
    "outlook_send_draft": {
      "description": "Send an existing draft (pair with outlook_create_draft for human-review send flow).",
      "impact": "high",
      "executionPayloadSchema": {
        "type": "object",
        "required": [
          "name",
          "arguments"
        ],
        "properties": {
          "name": {
            "const": "outlook_send_draft"
          },
          "arguments": {
            "properties": {
              "draft_id": {
                "title": "Draft Id",
                "type": "string"
              }
            },
            "required": [
              "draft_id"
            ],
            "title": "outlook_send_draftArguments",
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    },
    "outlook_send_message": {
      "description": "Send an email immediately, no human review.\n\nFor human-review workflows use outlook_create_draft + outlook_send_draft instead.\nFor replying to an existing message use outlook_reply; for calendar invites use outlook_rsvp.\nPass reply_to to route recipient replies to a different address (e.g. a shared team alias).\n",
      "impact": "high",
      "executionPayloadSchema": {
        "type": "object",
        "required": [
          "name",
          "arguments"
        ],
        "properties": {
          "name": {
            "const": "outlook_send_message"
          },
          "arguments": {
            "properties": {
              "to": {
                "items": {
                  "type": "string"
                },
                "title": "To",
                "type": "array"
              },
              "subject": {
                "title": "Subject",
                "type": "string"
              },
              "body": {
                "title": "Body",
                "type": "string"
              },
              "cc": {
                "anyOf": [
                  {
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Cc"
              },
              "bcc": {
                "anyOf": [
                  {
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Bcc"
              },
              "is_html": {
                "default": false,
                "title": "Is Html",
                "type": "boolean"
              },
              "importance": {
                "default": "normal",
                "title": "Importance",
                "type": "string"
              },
              "sensitivity": {
                "default": "normal",
                "title": "Sensitivity",
                "type": "string"
              },
              "request_read_receipt": {
                "default": false,
                "title": "Request Read Receipt",
                "type": "boolean"
              },
              "reply_to": {
                "anyOf": [
                  {
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Reply To"
              }
            },
            "required": [
              "to",
              "subject",
              "body"
            ],
            "title": "outlook_send_messageArguments",
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    },
    "outlook_send_with_attachments": {
      "description": "Send an email with file attachments; auto-switches to upload-session for files >3MB.\n\n`attachment_paths` must be absolute paths to files that exist on the host. Pass reply_to to\nroute replies to a different address.\n",
      "impact": "high",
      "executionPayloadSchema": {
        "type": "object",
        "required": [
          "name",
          "arguments"
        ],
        "properties": {
          "name": {
            "const": "outlook_send_with_attachments"
          },
          "arguments": {
            "properties": {
              "to": {
                "items": {
                  "type": "string"
                },
                "title": "To",
                "type": "array"
              },
              "subject": {
                "title": "Subject",
                "type": "string"
              },
              "body": {
                "title": "Body",
                "type": "string"
              },
              "attachment_paths": {
                "items": {
                  "type": "string"
                },
                "title": "Attachment Paths",
                "type": "array"
              },
              "cc": {
                "anyOf": [
                  {
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Cc"
              },
              "bcc": {
                "anyOf": [
                  {
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Bcc"
              },
              "is_html": {
                "default": false,
                "title": "Is Html",
                "type": "boolean"
              },
              "importance": {
                "default": "normal",
                "title": "Importance",
                "type": "string"
              },
              "reply_to": {
                "anyOf": [
                  {
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Reply To"
              }
            },
            "required": [
              "to",
              "subject",
              "body",
              "attachment_paths"
            ],
            "title": "outlook_send_with_attachmentsArguments",
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    },
    "outlook_set_inbox_override": {
      "description": "Create or update a sticky Focused/Other rule for a sender (upsert, case-insensitive).\n\nUse this to permanently change classification for FUTURE messages from a sender; use\noutlook_reclassify_message to fix ONE existing message.\n\nExample: outlook_set_inbox_override(sender_email=\"marketing@acme.com\", classify_as=\"other\")\nReturns status: \"created\" or \"updated\".\n",
      "impact": "medium",
      "executionPayloadSchema": {
        "type": "object",
        "required": [
          "name",
          "arguments"
        ],
        "properties": {
          "name": {
            "const": "outlook_set_inbox_override"
          },
          "arguments": {
            "properties": {
              "sender_email": {
                "title": "Sender Email",
                "type": "string"
              },
              "classify_as": {
                "title": "Classify As",
                "type": "string"
              }
            },
            "required": [
              "sender_email",
              "classify_as"
            ],
            "title": "outlook_set_inbox_overrideArguments",
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    },
