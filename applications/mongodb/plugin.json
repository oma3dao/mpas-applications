{
  "version": "1",
  "type": "MpasApplicationPlugin",
  "pluginDid": "did:web:wivity.com:plugins:mongodb-mcp-server",
  "pluginVersion": "0.1.0",
  "publisherDid": "did:web:wivity.com",
  "applicationDid": "did:web:wivity.com:applications:mongodb-mcp-server",
  "executionProfile": {
    "id": "did:web:profiles.oma3.org:mcp",
    "format": "mcp.toolsCall",
    "protocolVersion": "2024-11-05"
  },
  "credentialRequirements": [
    {
      "type": "mongodbConnectionString",
      "requiredCapabilities": [
        "databases:read",
        "databases:write",
        "collections:write",
        "indexes:write",
        "logs:read"
      ],
      "description": "MongoDB connection string supplied only within the credential adapter and scoped to the intended deployment and least-privileged database user. The reusable connection string must never be returned to the proposer."
    }
  ],
  "operations": {
    "atlas-local-connect-deployment": {
      "description": "Connect to a MongoDB Atlas Local deployment",
      "impact": "high",
      "executionPayloadSchema": {
        "type": "object",
        "required": [
          "name",
          "arguments"
        ],
        "properties": {
          "name": {
            "const": "atlas-local-connect-deployment"
          },
          "arguments": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "properties": {
              "deploymentName": {
                "type": "string"
              }
            },
            "required": [
              "deploymentName"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "atlas-local-create-deployment": {
      "description": "Create a MongoDB Atlas local deployment. Default image is preview. When the user does not specify an image tag, inform them that preview is used by default and provide this link for more information: https://hub.docker.com/r/mongodb/mongodb-atlas-local",
      "impact": "high",
      "executionPayloadSchema": {
        "type": "object",
        "required": [
          "name",
          "arguments"
        ],
        "properties": {
          "name": {
            "const": "atlas-local-create-deployment"
          },
          "arguments": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "properties": {
              "deploymentName": {
                "type": "string"
              },
              "loadSampleData": {
                "default": false,
                "type": "boolean"
              },
              "imageTag": {
                "default": "preview",
                "type": "string"
              }
            }
          }
        },
        "additionalProperties": false
      }
    },
    "atlas-local-delete-deployment": {
      "description": "Delete a MongoDB Atlas local deployment",
      "impact": "critical",
      "executionPayloadSchema": {
        "type": "object",
        "required": [
          "name",
          "arguments"
        ],
        "properties": {
          "name": {
            "const": "atlas-local-delete-deployment"
          },
          "arguments": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "properties": {
              "deploymentName": {
                "type": "string"
              }
            },
            "required": [
              "deploymentName"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "connect": {
      "description": "Connect to a MongoDB instance. The config resource captures if the server is already connected to a MongoDB cluster. If the user has configured a connection string or has previously called the connect tool, a connection is already established and there's no need to call this tool unless the user has explicitly requested to switch to a new MongoDB cluster.",
      "impact": "critical",
      "executionPayloadSchema": {
        "type": "object",
        "required": [
          "name",
          "arguments"
        ],
        "properties": {
          "name": {
            "const": "connect"
          },
          "arguments": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "properties": {
              "connectionString": {
                "type": "string"
              }
            },
            "required": [
              "connectionString"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "create-collection": {
      "description": "Creates a new collection in a database. If the database doesn't exist, it will be created automatically.",
      "impact": "high",
      "executionPayloadSchema": {
        "type": "object",
        "required": [
          "name",
          "arguments"
        ],
        "properties": {
          "name": {
            "const": "create-collection"
          },
          "arguments": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "properties": {
              "database": {
                "type": "string"
              },
              "collection": {
                "type": "string"
              }
            },
            "required": [
              "database",
              "collection"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "create-index": {
      "description": "Create an index for a collection",
      "impact": "high",
      "executionPayloadSchema": {
        "type": "object",
        "required": [
          "name",
          "arguments"
        ],
        "properties": {
          "name": {
            "const": "create-index"
          },
          "arguments": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "properties": {
              "database": {
                "type": "string"
              },
              "collection": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "definition": {
                "type": "array",
                "items": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "const": "classic"
                        },
                        "keys": {
                          "type": "object",
                          "propertyNames": {
                            "type": "string"
                          },
                          "additionalProperties": {
                            "anyOf": [
                              {
                                "type": "number",
                                "const": 1
                              },
                              {
                                "type": "number",
                                "const": -1
                              },
                              {
                                "type": "string",
                                "const": "2d"
                              },
                              {
                                "type": "string",
                                "const": "2dsphere"
                              },
                              {
                                "type": "string",
                                "const": "text"
                              },
                              {
                                "type": "string",
                                "const": "geoHaystack"
                              },
                              {
                                "type": "string",
                                "const": "hashed"
                              }
                            ]
                          }
                        }
                      },
                      "required": [
                        "type",
                        "keys"
                      ]
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "const": "vectorSearch"
                        },
                        "fields": {
                          "type": "array",
                          "items": {
                            "anyOf": [
                              {
                                "type": "object",
                                "properties": {
                                  "type": {
                                    "type": "string",
                                    "const": "filter"
                                  },
                                  "path": {
                                    "type": "string"
                                  }
                                },
                                "required": [
                                  "type",
                                  "path"
                                ],
                                "additionalProperties": false
                              },
                              {
                                "type": "object",
                                "properties": {
                                  "type": {
                                    "type": "string",
                                    "const": "vector"
                                  },
                                  "path": {
                                    "type": "string"
                                  },
                                  "numDimensions": {
                                    "default": 1024,
                                    "type": "number"
                                  },
                                  "similarity": {
                                    "default": "euclidean",
                                    "type": "string",
                                    "enum": [
                                      "cosine",
                                      "euclidean",
                                      "dotProduct"
                                    ]
                                  },
                                  "quantization": {
                                    "default": "none",
                                    "type": "string",
                                    "enum": [
                                      "none",
                                      "scalar",
                                      "binary"
                                    ]
                                  }
                                },
                                "required": [
                                  "type",
                                  "path"
                                ],
                                "additionalProperties": false
                              },
                              {
                                "type": "object",
                                "properties": {
                                  "type": {
                                    "type": "string",
                                    "const": "autoEmbed"
                                  },
                                  "path": {
                                    "type": "string"
                                  },
                                  "model": {
                                    "type": "string",
                                    "enum": [
                                      "voyage-4",
                                      "voyage-4-large",
                                      "voyage-4-lite",
                                      "voyage-code-3"
                                    ]
                                  },
                                  "modality": {
                                    "type": "string",
                                    "enum": [
                                      "text"
                                    ]
                                  }
                                },
                                "required": [
                                  "type",
                                  "path",
                                  "model",
                                  "modality"
                                ],
                                "additionalProperties": false
                              }
                            ]
                          }
                        }
                      },
                      "required": [
                        "type",
                        "fields"
                      ]
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "const": "search"
                        },
                        "analyzer": {
                          "default": "lucene.standard",
                          "type": "string"
                        },
                        "mappings": {
                          "type": "object",
                          "properties": {
                            "dynamic": {
                              "default": false,
                              "type": "boolean"
                            },
                            "fields": {
                              "type": "object",
                              "propertyNames": {
                                "type": "string"
                              },
                              "additionalProperties": {
                                "type": "object",
                                "properties": {
                                  "type": {
                                    "type": "string",
                                    "enum": [
                                      "autocomplete",
                                      "boolean",
                                      "date",
                                      "document",
                                      "embeddedDocuments",
                                      "geo",
                                      "number",
                                      "objectId",
                                      "string",
                                      "token",
                                      "uuid"
                                    ]
                                  }
                                },
                                "required": [
                                  "type"
                                ],
                                "additionalProperties": {}
                              }
                            }
                          }
                        },
                        "numPartitions": {
                          "default": "1",
                          "anyOf": [
                            {
                              "type": "string",
                              "const": "1"
                            },
                            {
                              "type": "string",
                              "const": "2"
                            },
                            {
                              "type": "string",
                              "const": "4"
                            }
                          ]
                        }
                      },
                      "required": [
                        "type",
                        "mappings"
                      ]
                    }
                  ]
                }
              }
            },
            "required": [
              "database",
              "collection",
              "definition"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "delete-many": {
      "description": "Removes all documents that match the filter from a MongoDB collection",
      "impact": "critical",
      "executionPayloadSchema": {
        "type": "object",
        "required": [
          "name",
          "arguments"
        ],
        "properties": {
          "name": {
            "const": "delete-many"
          },
          "arguments": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "properties": {
              "database": {
                "type": "string"
              },
              "collection": {
                "type": "string"
              },
              "filter": {
                "type": "object",
                "properties": {},
                "additionalProperties": {}
              }
            },
            "required": [
              "database",
              "collection"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "drop-collection": {
      "description": "Removes a collection or view from the database. The method also removes any indexes associated with the dropped collection.",
      "impact": "critical",
      "executionPayloadSchema": {
        "type": "object",
        "required": [
          "name",
          "arguments"
        ],
        "properties": {
          "name": {
            "const": "drop-collection"
          },
          "arguments": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "properties": {
              "database": {
                "type": "string"
              },
              "collection": {
                "type": "string"
              }
            },
            "required": [
              "database",
              "collection"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "drop-database": {
      "description": "Removes the specified database, deleting the associated data files",
      "impact": "critical",
      "executionPayloadSchema": {
        "type": "object",
        "required": [
          "name",
          "arguments"
        ],
        "properties": {
          "name": {
            "const": "drop-database"
          },
          "arguments": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "properties": {
              "database": {
                "type": "string"
              }
            },
            "required": [
              "database"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "drop-index": {
      "description": "Drop an index for the provided database and collection.",
      "impact": "critical",
      "executionPayloadSchema": {
        "type": "object",
        "required": [
          "name",
          "arguments"
        ],
        "properties": {
          "name": {
            "const": "drop-index"
          },
          "arguments": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "properties": {
              "database": {
                "type": "string"
              },
              "collection": {
                "type": "string"
              },
              "indexName": {
                "type": "string"
              },
              "type": {
                "type": "string",
                "enum": [
                  "classic",
                  "search"
                ]
              }
            },
            "required": [
              "database",
              "collection",
              "indexName",
              "type"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "insert-many": {
      "description": "Insert an array of documents into a MongoDB collection. If the list of documents is above com.mongodb/maxRequestPayloadBytes, consider inserting them in batches.",
      "impact": "high",
      "executionPayloadSchema": {
        "type": "object",
        "required": [
          "name",
          "arguments"
        ],
        "properties": {
          "name": {
            "const": "insert-many"
          },
          "arguments": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "properties": {
              "database": {
                "type": "string"
              },
              "collection": {
                "type": "string"
              },
              "documents": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {},
                  "additionalProperties": {}
                }
              }
            },
            "required": [
              "database",
              "collection",
              "documents"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "rename-collection": {
      "description": "Renames a collection in a MongoDB database",
      "impact": "high",
      "executionPayloadSchema": {
        "type": "object",
        "required": [
          "name",
          "arguments"
        ],
        "properties": {
          "name": {
            "const": "rename-collection"
          },
          "arguments": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "properties": {
              "database": {
                "type": "string"
              },
              "collection": {
                "type": "string"
              },
              "newName": {
                "type": "string"
              },
              "dropTarget": {
                "default": false,
                "type": "boolean"
              }
            },
            "required": [
              "database",
              "collection",
              "newName"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "update-many": {
      "description": "Updates all documents that match the specified filter for a collection. If the list of documents is above com.mongodb/maxRequestPayloadBytes, consider updating them in batches.",
      "impact": "critical",
      "executionPayloadSchema": {
        "type": "object",
        "required": [
          "name",
          "arguments"
        ],
        "properties": {
          "name": {
            "const": "update-many"
          },
          "arguments": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "properties": {
              "database": {
                "type": "string"
              },
              "collection": {
                "type": "string"
              },
              "filter": {
                "type": "object",
                "properties": {},
                "additionalProperties": {}
              },
              "update": {
                "type": "object",
                "properties": {},
                "additionalProperties": {}
              },
              "upsert": {
                "type": "boolean"
              }
            },
            "required": [
              "database",
              "collection",
              "update"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  }
}
