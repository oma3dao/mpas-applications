  "operations": {
    "bookmark_tweet": {
      "description": "Adds the tweet to bookmarks",
      "impact": "medium",
      "executionPayloadSchema": {
        "type": "object",
        "required": [
          "name",
          "arguments"
        ],
        "properties": {
          "name": {
            "const": "bookmark_tweet"
          },
          "arguments": {
            "additionalProperties": false,
            "properties": {
              "tweet_id": {
                "type": "string",
                "description": "The ID of the tweet to bookmark."
              },
              "folder_id": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "The ID of the bookmark folder to add the tweet to. (Currently not supported by Tweepy v2 client, will be ignored)."
              }
            },
            "required": [
              "tweet_id"
            ],
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    },
