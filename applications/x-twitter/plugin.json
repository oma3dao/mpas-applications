{
  "version": "1",
  "type": "MpasApplicationPlugin",
  "pluginDid": "did:web:wivity.com:plugins:x-twitter-mcp-server",
  "pluginVersion": "0.1.0",
  "publisherDid": "did:web:wivity.com",
  "applicationDid": "did:web:wivity.com:applications:x-twitter-mcp-server",
  "executionProfile": {
    "id": "did:web:profiles.oma3.org:mcp",
    "format": "mcp.toolsCall",
    "protocolVersion": "2024-11-05"
  },
  "credentialRequirements": [
    {
      "type": "xApiCredential",
      "expectedAuthority": [
        "tweets:read",
        "tweets:write",
        "users:read",
        "likes:write",
        "bookmarks:read",
        "bookmarks:write"
      ],
      "description": "X API credentials supplied only within the credential adapter and scoped to the intended X application and user account. API keys, secrets, access tokens, and bearer tokens must never be returned to the proposer. Bookmark operations additionally require an OAuth 2.0 user access token."
    }
  ],
  "toolSurface": {
    "hash": {
      "alg": "sha-256",
      "value": "BRv4A1bg5-wDJWcfXfcLcQFSo439hZp-_xjk_Mp-Eks"
    },
    "toolNames": [
      "bookmark_tweet",
      "create_poll_tweet",
      "delete_all_bookmarks",
      "delete_bookmark",
      "delete_tweet",
      "favorite_tweet",
      "get_bookmarks",
      "get_highlights_tweets",
      "get_latest_timeline",
      "get_timeline",
      "get_trends",
      "get_tweet_details",
      "get_user_by_id",
      "get_user_by_screen_name",
      "get_user_followers",
      "get_user_followers_you_know",
      "get_user_following",
      "get_user_mentions",
      "get_user_profile",
      "get_user_subscriptions",
      "post_tweet",
      "search_twitter",
      "unfavorite_tweet",
      "vote_on_poll"
    ]
  },
  "operations": {
    "create_poll_tweet": {
      "description": "Create a tweet with a poll",
      "impact": "high",
      "executionPayloadSchema": {
        "type": "object",
        "required": [
          "name",
          "arguments"
        ],
        "properties": {
          "name": {
            "const": "create_poll_tweet"
          },
          "arguments": {
            "additionalProperties": false,
            "properties": {
              "text": {
                "type": "string",
                "description": "The question or text for the poll."
              },
              "choices": {
                "items": {
                  "type": "string"
                },
                "type": "array",
                "description": "A list of poll choices (2-4 choices, each max 25 characters)."
              },
              "duration_minutes": {
                "type": "integer",
                "description": "Duration of the poll in minutes (min 5, max 10080 (7 days))."
              }
            },
            "required": [
              "text",
              "choices",
              "duration_minutes"
            ],
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    },
    "delete_all_bookmarks": {
      "description": "DESTRUCTIVE AND IRREVERSIBLE: Permanently deletes ALL bookmarks one by one. This cannot be undone. Always confirm explicitly with the user before calling this tool.",
      "impact": "critical",
      "executionPayloadSchema": {
        "type": "object",
        "required": [
          "name",
          "arguments"
        ],
        "properties": {
          "name": {
            "const": "delete_all_bookmarks"
          },
          "arguments": {
            "additionalProperties": false,
            "properties": {},
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    },
    "delete_tweet": {
      "description": "Delete a tweet by its ID",
      "impact": "critical",
      "executionPayloadSchema": {
        "type": "object",
        "required": [
          "name",
          "arguments"
        ],
        "properties": {
          "name": {
            "const": "delete_tweet"
          },
          "arguments": {
            "additionalProperties": false,
            "properties": {
              "tweet_id": {
                "type": "string",
                "description": "The ID of the tweet to delete."
              }
            },
            "required": [
              "tweet_id"
            ],
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    },
    "favorite_tweet": {
      "description": "Favorites a tweet",
      "impact": "medium",
      "executionPayloadSchema": {
        "type": "object",
        "required": [
          "name",
          "arguments"
        ],
        "properties": {
          "name": {
            "const": "favorite_tweet"
          },
          "arguments": {
            "additionalProperties": false,
            "properties": {
              "tweet_id": {
                "type": "string",
                "description": "The ID of the tweet to favorite (like)."
              }
            },
            "required": [
              "tweet_id"
            ],
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    },
    "post_tweet": {
      "description": "Post a tweet with optional media, reply, and tags",
      "impact": "high",
      "executionPayloadSchema": {
        "type": "object",
        "required": [
          "name",
          "arguments"
        ],
        "properties": {
          "name": {
            "const": "post_tweet"
          },
          "arguments": {
            "additionalProperties": false,
            "properties": {
              "text": {
                "type": "string",
                "description": "The text content of the tweet. Max 280 characters."
              },
              "media_paths": {
                "anyOf": [
                  {
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "A list of local file paths to media (images, videos) to be uploaded and attached."
              },
              "reply_to": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "The ID of the tweet to reply to."
              },
              "tags": {
                "anyOf": [
                  {
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "A list of hashtags (without '#') to append to the tweet."
              }
            },
            "required": [
              "text"
            ],
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    },
    "unfavorite_tweet": {
      "description": "Unfavorites a tweet",
      "impact": "medium",
      "executionPayloadSchema": {
        "type": "object",
        "required": [
          "name",
          "arguments"
        ],
        "properties": {
          "name": {
            "const": "unfavorite_tweet"
          },
          "arguments": {
            "additionalProperties": false,
            "properties": {
              "tweet_id": {
                "type": "string",
                "description": "The ID of the tweet to unfavorite (unlike)."
              }
            },
            "required": [
              "tweet_id"
            ],
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    }
  }
}
