{
  "version": "1",
  "type": "MpasApplicationPlugin",
  "pluginDid": "did:web:wivity.com:plugins:coinbase-advanced-trade-mcp-server",
  "pluginVersion": "0.1.0",
  "publisherDid": "did:web:wivity.com",
  "applicationDid": "did:web:wivity.com:applications:coinbase-advanced-trade-mcp-server",
  "executionProfile": {
    "id": "did:web:profiles.oma3.org:mcp",
    "format": "mcp.toolsCall",
    "protocolVersion": "2024-11-05"
  },
  "credentialRequirements": [
    {
      "type": "coinbaseCdpApiKey",
      "requiredCapabilities": [
        "advanced-trade:view",
        "advanced-trade:trade",
        "advanced-trade:transfer"
      ],
      "description": "A Coinbase Developer Platform API key scoped to the intended Advanced Trade portfolio. The Credential Adapter must retain the private key and execute the local Coinbase CLI MCP server; credentials must never be disclosed to the proposer."
    }
  ],
  "operations": {
    "coinbase_balance": {
      "description": "GET /balance — Lists account balances across currencies, showing available funds and amounts on hold. Read-only. Use before trading or transferring to confirm available funds; available_balance excludes funds held by open orders.",
      "impact": "medium",
      "executionPayloadSchema": {
        "type": "object",
        "required": [
          "name",
          "arguments"
        ],
        "properties": {
          "name": {
            "const": "coinbase_balance"
          },
          "arguments": {
            "type": "object",
            "properties": {
              "portfolio_id": {
                "type": "string",
                "description": "Filter by portfolio"
              },
              "show_zero": {
                "type": "boolean",
                "description": "Include zero-balance accounts (default false)"
              },
              "limit": {
                "type": "integer",
                "description": "Results per page"
              },
              "cursor": {
                "type": "string",
                "description": "Pagination cursor"
              }
            }
          }
        },
        "additionalProperties": false
      }
    },
    "coinbase_convert_execute": {
      "description": "POST /convert/execute/{quote_id} — Executes a previously quoted conversion using the quote id from convert_quote. This moves funds at the quoted rate — always get a fresh quote first, since quotes expire. The from/to currencies must match the original quote. (2 fields, 2 required)",
      "impact": "critical",
      "executionPayloadSchema": {
        "type": "object",
        "required": [
          "name",
          "arguments"
        ],
        "properties": {
          "name": {
            "const": "coinbase_convert_execute"
          },
          "arguments": {
            "type": "object",
            "properties": {
              "quote_id": {
                "type": "string",
                "description": "Quote ID from convert quote response"
              },
              "from": {
                "type": "string",
                "description": "Source currency",
                "example": "USDC"
              },
              "to": {
                "type": "string",
                "description": "Target currency",
                "example": "USD"
              }
            },
            "required": [
              "quote_id",
              "from",
              "to"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "coinbase_convert_get": {
      "description": "GET /convert/get/{quote_id} — Check status of a conversion by quote ID.",
      "impact": "medium",
      "executionPayloadSchema": {
        "type": "object",
        "required": [
          "name",
          "arguments"
        ],
        "properties": {
          "name": {
            "const": "coinbase_convert_get"
          },
          "arguments": {
            "type": "object",
            "properties": {
              "quote_id": {
                "type": "string",
                "description": "Quote ID"
              },
              "from": {
                "type": "string",
                "description": "Source currency"
              },
              "to": {
                "type": "string",
                "description": "Target currency"
              }
            },
            "required": [
              "quote_id",
              "from",
              "to"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "coinbase_convert_quote": {
      "description": "POST /convert/quote — Quotes a currency conversion (e.g. stablecoin pairs), returning rate, fees, and a quote id. Read-only preview — pass the id to convert_execute to commit; quotes expire, so execute promptly. (3 fields, 3 required)",
      "impact": "medium",
      "executionPayloadSchema": {
        "type": "object",
        "required": [
          "name",
          "arguments"
        ],
        "properties": {
          "name": {
            "const": "coinbase_convert_quote"
          },
          "arguments": {
            "type": "object",
