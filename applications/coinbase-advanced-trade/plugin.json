              },
              "cursor": {
                "type": "string",
                "description": "Pagination cursor"
              }
            }
          }
        },
        "additionalProperties": false
      }
    },
    "coinbase_orders_get": {
      "description": "GET /orders/{order_id} — Retrieves the full status and fill details of a single order by ID. Read-only. Use after creating an order to confirm execution.",
      "impact": "medium",
