{
  "version": "1",
  "type": "MpasApplicationPlugin",
  "pluginDid": "did:web:wivity.com:plugins:coinbase-advanced-trade-mcp-server",
  "pluginVersion": "0.1.0",
  "publisherDid": "did:web:wivity.com",
  "applicationDid": "did:web:wivity.com:applications:coinbase-advanced-trade-mcp-server",
  "executionProfile": {
    "id": "did:web:profiles.oma3.org:mcp",
    "format": "mcp.toolsCall",
    "protocolVersion": "2024-11-05"
  },
  "credentialRequirements": [
    {
      "type": "coinbaseCdpApiKey",
      "requiredCapabilities": [
        "advanced-trade:view",
        "advanced-trade:trade",
        "advanced-trade:transfer"
      ],
      "description": "A Coinbase Developer Platform API key scoped to the intended Advanced Trade portfolio. The Credential Adapter must retain the private key and execute the local Coinbase CLI MCP server; credentials must never be disclosed to the proposer."
    }
  ],
  "operations": {
    "coinbase_convert_execute": {
      "description": "POST /convert/execute/{quote_id} — Executes a previously quoted conversion using the quote id from convert_quote. This moves funds at the quoted rate — always get a fresh quote first, since quotes expire. The from/to currencies must match the original quote. (2 fields, 2 required)",
      "impact": "high",
      "executionPayloadSchema": {
        "type": "object",
        "required": [
          "name",
          "arguments"
        ],
        "properties": {
          "name": {
            "const": "coinbase_convert_execute"
          },
          "arguments": {
            "type": "object",
            "properties": {
              "quote_id": {
                "type": "string",
                "description": "Quote ID from convert quote response"
              },
              "from": {
                "type": "string",
                "description": "Source currency",
                "example": "USDC"
              },
              "to": {
                "type": "string",
                "description": "Target currency",
                "example": "USD"
              }
            },
            "required": [
              "quote_id",
              "from",
              "to"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "coinbase_orders_cancel": {
      "description": "POST /orders/cancel — Cancels one or more open orders by ID. Removes resting orders from the book so reserved funds are released; already-filled portions are unaffected. Returns per-order success so a partial batch can fail. (1 fields, 1 required)",
      "impact": "low",
      "executionPayloadSchema": {
        "type": "object",
        "required": [
          "name",
          "arguments"
        ],
        "properties": {
          "name": {
            "const": "coinbase_orders_cancel"
          },
          "arguments": {
            "type": "object",
            "properties": {
              "order_ids": {
                "type": "array",
                "description": "Order IDs to cancel"
              }
            },
            "required": [
              "order_ids"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "coinbase_orders_close_position": {
      "description": "POST /orders/close-position — Places a market order to flatten an open position for a product, moving funds immediately. Omit size for a full close or set it for a partial close. Preview the equivalent order first if fee or slippage impact matters. (3 fields, 2 required)",
      "impact": "medium",
      "executionPayloadSchema": {
        "type": "object",
        "required": [
          "name",
          "arguments"
        ],
        "properties": {
          "name": {
            "const": "coinbase_orders_close_position"
          },
          "arguments": {
            "type": "object",
            "properties": {
              "client_order_id": {
                "type": "string",
                "description": "Idempotency key"
              },
              "product_id": {
                "type": "string",
                "description": "Product to close",
                "example": "BTC-PERP"
              },
              "size": {
                "type": "string",
                "description": "Partial close size (omit for full close)",
                "example": "0.001"
              }
            },
            "required": [
              "client_order_id",
              "product_id"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "coinbase_orders_create": {
      "description": "POST /orders — Places a live order — executes immediately and moves funds (market buy spends quote currency; sell disposes of base). Preview with orders_preview first to estimate fees, fill price, and slippage. (14 fields, 3 required) (one of: base_size, quote_size)",
      "impact": "high",
      "executionPayloadSchema": {
        "type": "object",
        "required": [
          "name",
          "arguments"
        ],
        "properties": {
          "name": {
            "const": "coinbase_orders_create"
          },
          "arguments": {
            "type": "object",
            "properties": {
              "product_id": {
                "type": "string",
                "description": "Trading pair",
                "example": "BTC-USD"
              },
              "side": {
                "type": "string",
                "description": "BUY or SELL",
                "enum": [
                  "BUY",
                  "SELL"
                ],
                "example": "BUY"
              },
              "type": {
                "type": "string",
                "description": "market = fill now; limit = fill at price or better; stop_limit = limit triggered at stop_price",
                "enum": [
                  "market",
                  "limit",
                  "stop_limit"
                ],
                "example": "market"
              },
              "quote_size": {
                "type": "string",
                "description": "Quote currency amount (e.g. spend $100 USD). Market buy only. Mutually exclusive with base_size.",
                "example": "100.00"
              },
              "base_size": {
                "type": "string",
                "description": "Base currency amount (e.g. buy 0.001 BTC). Any side/type.",
                "example": "0.001"
              },
              "limit_price": {
                "type": "string",
                "description": "Limit price (limit/stop_limit orders)",
                "example": "65000.00"
              },
              "stop_price": {
                "type": "string",
                "description": "Stop price (stop_limit orders)",
                "example": "60000.00"
              },
              "stop_direction": {
                "type": "string",
                "description": "up = trigger when price rises above stop_price. down = trigger when falls below.",
                "enum": [
                  "up",
                  "down"
                ],
                "example": "down"
              },
              "post_only": {
                "type": "boolean",
                "description": "Post-only mode (limit orders). Rejects if would take liquidity."
              },
              "time_in_force": {
                "type": "string",
                "description": "GTC=good til cancelled. IOC=immediate or cancel. FOK=fill or kill.",
                "enum": [
                  "GTC",
                  "IOC",
                  "FOK",
                  "GTD"
                ],
                "example": "GTC"
              },
              "end_time": {
                "type": "string",
                "description": "Expiry time for GTD orders (RFC 3339). Required when time_in_force=GTD.",
                "format": "date-time",
                "example": "2024-12-31T23:59:59Z"
              },
              "reduce_only": {
                "type": "boolean",
                "description": "Only reduce existing position. Rejects if would increase exposure."
              },
              "portfolio_id": {
                "type": "string",
                "description": "Scopes the order to a specific portfolio (defaults to auth-scoped portfolio)"
              },
              "client_order_id": {
                "type": "string",
                "description": "Idempotency key (auto-generated if omitted)"
              }
            },
            "required": [
              "product_id",
              "side",
              "type"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "coinbase_orders_edit": {
      "description": "POST /orders/edit — Atomically update an open order's price or size without cancelling. Avoids the cancel+replace exposure window. (3 fields, 1 required)",
      "impact": "high",
      "executionPayloadSchema": {
        "type": "object",
        "required": [
          "name",
          "arguments"
        ],
        "properties": {
          "name": {
            "const": "coinbase_orders_edit"
          },
          "arguments": {
            "type": "object",
            "properties": {
              "order_id": {
                "type": "string",
                "description": "Order to edit"
              },
              "base_size": {
                "type": "string",
                "description": "New base size",
                "example": "0.002"
              },
              "limit_price": {
                "type": "string",
                "description": "New limit price",
                "example": "64000.00"
              }
            },
            "required": [
              "order_id"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "coinbase_portfolios_create": {
      "description": "POST /portfolios — Creates a new named portfolio for segregating funds and positions. Does not move any funds; use transfer afterward to fund it. (1 fields, 1 required)",
      "impact": "medium",
      "executionPayloadSchema": {
        "type": "object",
        "required": [
          "name",
          "arguments"
        ],
        "properties": {
          "name": {
            "const": "coinbase_portfolios_create"
          },
          "arguments": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "Portfolio name",
                "example": "agent-1"
              }
            },
            "required": [
              "name"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "coinbase_portfolios_delete": {
      "description": "DELETE /portfolios/{portfolio_id} — Permanently deletes a portfolio. The portfolio must be empty first — transfer out any remaining funds and close all positions before deleting. The DEFAULT portfolio cannot be deleted.",
      "impact": "medium",
      "executionPayloadSchema": {
        "type": "object",
        "required": [
          "name",
          "arguments"
        ],
        "properties": {
          "name": {
            "const": "coinbase_portfolios_delete"
          },
          "arguments": {
            "type": "object",
            "properties": {
              "portfolio_id": {
                "type": "string",
                "description": "Portfolio UUID"
              }
            },
            "required": [
              "portfolio_id"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "coinbase_set_env": {
      "description": "Switch the active environment.",
      "impact": "critical",
      "executionPayloadSchema": {
        "type": "object",
        "required": [
          "name",
          "arguments"
        ],
        "properties": {
          "name": {
            "const": "coinbase_set_env"
          },
          "arguments": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "Environment name"
              }
            },
            "required": [
              "name"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "coinbase_transfer": {
      "description": "POST /transfer — Moves funds of a single currency from one portfolio to another. This executes immediately and moves money — verify the source has sufficient available balance first. Both portfolio UUIDs come from portfolios_list. (4 fields, 4 required)",
      "impact": "critical",
      "executionPayloadSchema": {
        "type": "object",
        "required": [
          "name",
          "arguments"
        ],
        "properties": {
          "name": {
            "const": "coinbase_transfer"
          },
          "arguments": {
            "type": "object",
            "properties": {
              "amount": {
                "type": "string",
                "description": "Amount to transfer",
                "example": "100.00"
              },
              "currency": {
                "type": "string",
                "description": "Currency",
                "example": "USD"
              },
              "from": {
                "type": "string",
                "description": "Source portfolio UUID",
                "example": "d17b3486-..."
              },
              "to": {
                "type": "string",
                "description": "Target portfolio UUID",
                "example": "a44ef7a8-..."
              }
            },
            "required": [
              "amount",
              "currency",
              "from",
              "to"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  }
}
