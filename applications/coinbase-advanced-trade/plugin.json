              "from": {
                "type": "string",
                "description": "Source currency",
                "example": "USDC"
              },
              "to": {
                "type": "string",
                "description": "Target currency",
                "example": "USD"
              },
              "amount": {
                "type": "string",
                "description": "Amount to convert",
                "example": "100.00"
              }
            },
            "required": [
              "from",
              "to",
              "amount"
            ]
          }
        },
        "additionalProperties": false
      }
    },
