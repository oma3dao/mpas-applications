                "type": "string",
                "description": "Filter by order ID"
              },
              "start": {
                "type": "string",
                "description": "Start time (RFC 3339 with timezone, e.g. 2024-01-01T00:00:00Z)",
                "format": "date-time"
              },
              "end": {
                "type": "string",
                "description": "End time (RFC 3339 with timezone, e.g. 2024-12-31T23:59:59Z)",
                "format": "date-time"
              },
              "side": {
                "type": "string",
                "description": "Filter by side",
                "enum": [
