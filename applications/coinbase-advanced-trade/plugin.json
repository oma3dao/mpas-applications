    "coinbase_help": {
      "description": "Get detailed help for a command: field descriptions, query parameters, and usage.",
      "impact": "medium",
      "executionPayloadSchema": {
        "type": "object",
        "required": [
          "name",
          "arguments"
        ],
        "properties": {
          "name": {
            "const": "coinbase_help"
          },
          "arguments": {
            "type": "object",
            "properties": {
              "resource": {
                "type": "string",
                "description": "Resource name (e.g. \"orders\"). Omit for top-level actions like balance, transfer, fees."
              },
              "action": {
                "type": "string",
                "description": "Action name (e.g. \"create\", \"balance\")"
              }
            },
            "required": [
