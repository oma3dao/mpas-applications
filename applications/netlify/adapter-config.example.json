{
  "version": "1",
  "type": "MpasAdapterDeploymentConfig",
  "name": "netlify",
  "target": {
    "applicationDid": "did:web:wivity.com:applications:netlify-mcp-server"
  },
  "plugin": {
    "pluginDid": "did:web:wivity.com:plugins:netlify-mcp-server",
    "pluginVersion": "0.1.0",
    "artifactDid": "did:artifact:bafkreifxiki3rwiqjyd3hkecbuvpl5kfjue2mjbqmqhonzqkoagzebb45a",
    "path": "/absolute/path/to/mpas-applications/applications/netlify/plugin.json"
  },
  "credentialBindings": [
    {
      "credentialHandle": "netlifyMcpOAuthAccessToken",
      "provider": "file"
    }
  ],
  "executionTarget": {
    "type": "mcp.http",
    "url": "https://netlify-mcp.netlify.app/mcp",
    "auth": {
      "type": "oauth2",
      "session": "netlify",
      "scopes": [
        "read",
        "write"
      ]
    }
  },
  "policy": {
    "version": "1",
    "type": "MpasApplicationPolicy",
    "policyProfileUrl": "https://github.com/oma3dao/mpas/blob/main/specs/mpas-profile-policy-json.md",
    "applicationDid": "did:web:wivity.com:applications:netlify-mcp-server",
    "executionProfile": {
      "id": "did:web:profiles.oma3.org:mcp",
      "format": "mcp.toolsCall"
    },
    "defaultRequirement": {
      "type": "threshold",
      "threshold": 1,
      "eligibleSignerGroup": "approvers",
      "decision": "approve"
    },
    "signerGroups": {
      "all": [
        "REPLACE_WITH_PROPOSER_DID",
        "REPLACE_WITH_APPROVER_DID"
      ],
      "proposers": [
        "REPLACE_WITH_PROPOSER_DID"
      ],
      "approvers": [
        "REPLACE_WITH_APPROVER_DID"
      ]
    },
    "policies": {
      "netlify-project-services-updater": [
        {
          "description": "Security-configuration change; team-wide when appliesTo == all-projects.",
          "match": {
            "conditions": [
              {
                "source": "executionPayload",
                "path": "/arguments/selectSchema/operation",
                "op": "eq",
                "value": "update-visitor-access-controls"
              }
            ]
          },
          "requirements": {
            "type": "threshold",
            "threshold": 1,
            "eligibleSignerGroup": "approvers",
            "decision": "approve"
          }
        },
        {
          "description": "Irreversible data deletion: deletes a form submission.",
          "match": {
            "conditions": [
              {
                "source": "executionPayload",
                "path": "/arguments/selectSchema/operation",
                "op": "eq",
                "value": "manage-form-submissions"
              },
              {
                "source": "executionPayload",
                "path": "/arguments/selectSchema/params/action",
                "op": "eq",
                "value": "delete-submission"
              }
            ]
          },
          "requirements": {
            "type": "threshold",
            "threshold": 1,
            "eligibleSignerGroup": "approvers",
            "decision": "approve"
          }
        },
        {
          "description": "Writes or overwrites an environment variable, which may hold a credential or production configuration.",
          "match": {
            "conditions": [
              {
                "source": "executionPayload",
                "path": "/arguments/selectSchema/operation",
                "op": "eq",
                "value": "manage-env-vars"
              },
              {
                "source": "executionPayload",
                "path": "/arguments/selectSchema/params/upsertEnvVar",
                "op": "eq",
                "value": true
              }
            ]
          },
          "requirements": {
            "type": "threshold",
            "threshold": 1,
            "eligibleSignerGroup": "approvers",
            "decision": "approve"
          }
        },
        {
          "description": "Irreversible: deletes an environment variable, regardless of other flags.",
          "match": {
            "conditions": [
              {
                "source": "executionPayload",
                "path": "/arguments/selectSchema/operation",
                "op": "eq",
                "value": "manage-env-vars"
              },
              {
                "source": "executionPayload",
                "path": "/arguments/selectSchema/params/deleteEnvVar",
                "op": "eq",
                "value": true
              }
            ]
          },
          "requirements": {
            "type": "threshold",
            "threshold": 1,
            "eligibleSignerGroup": "approvers",
            "decision": "approve"
          }
        }
      ]
    }
  },
  "signerKeys": [
    {
      "did": "REPLACE_WITH_PROPOSER_DID",
      "label": "Proposer Signer"
    },
    {
      "did": "REPLACE_WITH_APPROVER_DID",
      "label": "Approver Signer"
    }
  ]
}
