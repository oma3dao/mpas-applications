{
  "version": "1",
  "type": "MpasAdapterDeploymentConfig",
  "name": "cloudflare-dns-pages",
  "target": {
    "applicationDid": "did:web:wivity.com:applications:cloudflare-mcp-server"
  },
  "plugin": {
    "pluginDid": "did:web:wivity.com:plugins:cloudflare-mcp-server",
    "pluginVersion": "0.1.0",
    "artifactDid": "did:artifact:bafkreiafmty2wio3qmoes7cbujaen6fj4q2mm7adknp537qne7nxcbi2zu",
    "path": "/absolute/path/to/mpas-applications/applications/cloudflare/plugin.json"
  },
  "credentialBindings": [
    {
      "credentialHandle": "cloudflareApiToken",
      "provider": "file"
    }
  ],
  "executionTarget": {
    "type": "mcp.stdio",
    "command": "node",
    "args": [
      "/absolute/path/to/mpas-applications/applications/cloudflare/adapter/transport.mjs"
    ],
    "env": {
      "CLOUDFLARE_API_TOKEN": "{{credential:cloudflareApiToken}}"
    }
  },
  "policy": {
    "version": "1",
    "type": "MpasApplicationPolicy",
    "policyProfileUrl": "https://github.com/oma3dao/mpas/blob/main/specs/mpas-profile-policy-json.md",
    "applicationDid": "did:web:wivity.com:applications:cloudflare-mcp-server",
    "executionProfile": {
      "id": "did:web:profiles.oma3.org:mcp",
      "format": "mcp.toolsCall"
    },
    "defaultRequirement": {
      "type": "threshold",
      "threshold": 1,
      "eligibleSignerGroup": "approvers",
      "decision": "approve"
    },
    "signerGroups": {
      "all": [
        "REPLACE_WITH_PROPOSER_DID",
        "REPLACE_WITH_APPROVER_DID"
      ],
      "proposers": [
        "REPLACE_WITH_PROPOSER_DID"
      ],
      "approvers": [
        "REPLACE_WITH_APPROVER_DID"
      ]
    },
    "policies": {
      "dns_records_create": [
        {
          "description": "Restrict writes to the operator-approved signerset.com and oxrunner.com zone IDs (not domain names).",
          "reject": true,
          "match": {
            "conditions": [
              {
                "source": "executionPayload",
                "path": "/arguments/path/zone_id",
                "op": "notIn",
                "value": [
                  "REPLACE_WITH_SIGNERSET_ZONE_ID",
                  "REPLACE_WITH_OXRUNNER_ZONE_ID"
                ]
              }
            ]
          }
        }
      ],
      "dns_records_delete": [
